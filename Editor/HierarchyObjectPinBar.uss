.mf-hierarchy-object-pin-viewport {
    position: absolute;
    top: 21px;
    right: 0;
    bottom: 0;
    left: 0;
    overflow: hidden;
}

.mf-hierarchy-object-pin-bar {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 44px;
    min-height: 44px;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.14);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.mf-hierarchy-object-pin-row {
    height: 22px;
    min-height: 22px;
    flex-direction: row;
    align-items: center;
    padding-left: 3px;
    padding-right: 3px;
}

.mf-hierarchy-object-pin-tag-row {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.22);
}

.mf-hierarchy-object-pin-toggle,
.mf-hierarchy-object-pin-tag-button,
.mf-hierarchy-object-pin-button {
    height: 18px;
    min-height: 18px;
    margin-left: 1px;
    margin-right: 1px;
    padding-left: 5px;
    padding-right: 5px;
    flex-shrink: 0;
}

.mf-hierarchy-object-pin-tag-button {
    min-width: 48px;
    max-width: 72px;
}

.mf-hierarchy-object-pin-toggle {
    width: 22px;
    padding-left: 1px;
    padding-right: 1px;
}

.mf-hierarchy-object-pin-button {
    max-width: 130px;
    -unity-text-overflow-position: end;
    text-overflow: ellipsis;
    overflow: hidden;
}

.mf-hierarchy-object-pin-button--selected {
    color: white;
    background-color: rgb(42, 113, 171);
}

.mf-hierarchy-object-pin-button--missing {
    opacity: 0.55;
}

.mf-hierarchy-object-pin-scroll {
    height: 22px;
    flex-grow: 1;
    flex-shrink: 1;
}

.mf-hierarchy-object-pin-list {
    height: 22px;
    flex-direction: row;
    align-items: center;
}

.mf-hierarchy-object-pin-placeholder {
    margin-left: 5px;
    color: rgba(190, 190, 190, 0.7);
    -unity-text-align: middle-left;
}
